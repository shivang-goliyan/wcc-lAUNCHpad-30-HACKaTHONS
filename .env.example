# ---- required ----
DOMAIN=namicare.xyz                 # or <vm-ip-with-dashes>.sslip.io — HTTPS is automatic (needed for the mic + Twilio)
APP_URL=https://namicare.xyz        # public URL, no trailing slash
COOKIE_SECRET=change-me-long-random
CONTACT_TOKEN_SECRET=change-me-long-random-2
POSTGRES_PASSWORD=change-me

# ---- voice (browser realtime) ----
OPENAI_API_KEY=
VOICE_MODEL=gpt-realtime-2.1        # or gpt-realtime-2.1-mini (cheaper)
VOICE_NAME=marin
VOICE_TRANSCRIBE_MODEL=gpt-4o-transcribe

# ---- text agents: caller, clinic simulator, extractor, text chat ----
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# ...or any OpenAI-compatible provider (OpenRouter, OpenAI, Gemini, Groq):
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=<that provider's model id>
# LLM_FALLBACK_MODELS=<comma list, OpenRouter only: tried when the first is busy>
# OPENROUTER_API_KEY_2=<a second key, used when the first is rate-limited>

# ---- real phone calls (video + live proof). Only allow-listed numbers are ever dialled ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1XXXXXXXXXX
TWILIO_VOICE_HI=Polly.Aditi
ADMIN_PASSWORD=change-me-admin   # /try?video=1&key=... creates the real-calls household for the video
PHONE_ALLOWLIST=+91XXXXXXXXXX,+91YYYYYYYYYY
VIDEO_CLINIC_PHONE=                  # teammate playing the receptionist (seed:video)
VIDEO_ARJUN_PHONE=                   # teammate playing Arjun (seed:video)
VIDEO_MEERA_PHONE=

# ---- cost guards for the public link ----
VOICE_MAX_SESSION_SEC=300
VOICE_SESSIONS_PER_IP_PER_HOUR=6
VOICE_DAILY_MINUTES_CAP=600
KILL_SWITCH_VOICE=false
KILL_SWITCH_LLM=false
